# ==============================================================================
# Music2Signature - Configuración de Variables de Entorno
# ==============================================================================

# [REQUERIDO] Token de autenticación de Plex (obtenlo en https://plex.tv)
PLEX_TOKEN=tu_token_de_plex_aqui

# [OPCIONAL] URL directa de tu servidor Plex
# Si no se especifica, Music2Signature intentará descubrirlo automáticamente mediante la API de plex.tv.
# PLEX_URL=http://192.168.1.100:32400

# [OPCIONAL] Usuario específico de Plex para filtrar sesiones
# Si no se especifica, se usará el usuario propietario de la cuenta.
# PLEX_USER=tu_usuario_plex

# Duración de la caché de las imágenes SVG en segundos (default: 60)
CACHE_DURATION=60

# Tema visual por defecto: normal, dark, transparent-light, transparent-dark
DEFAULT_THEME=normal

# Dimensiones por defecto de la tarjeta SVG
IMAGE_WIDTH=400
IMAGE_HEIGHT=90

# Visualización cuando no hay nada en reproducción:
# 'bars' -> muestra únicamente las barras de audio animadas centradas (por defecto)
# 'full' -> muestra la tarjeta completa con texto 'Sin reproducción' y recuadro
IDLE_MODE=bars

# Animación de marquesina (marquee) para títulos y artista-disco largos:
# 'true' -> anima con desplazamiento suave si el texto excede el ancho (por defecto)
# 'false' -> mantiene el texto recortado estático
MARQUEE_ENABLED=true

# Configuración de carátula embebida:
# COVER_MAX_DIM: Dimensión máxima en px para la miniatura de la portada (default: 100)
# COVER_QUALITY: Calidad de compresión JPEG de la portada (default: 70)
COVER_MAX_DIM=100
COVER_QUALITY=70

# Filtrado de sesiones de video (películas, series, clips):
# 'false' -> filtra estrictamente solo pistas de música/audio (por defecto)
# 'true'  -> permite mostrar películas y series si no hay música
ALLOW_VIDEO=false

# Modo depuración (usar false en producción)
DEBUG=false


